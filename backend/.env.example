PORT=3001
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres
# Production: use Supabase's CA certificate; TLS verification stays enabled.
# DATABASE_CA_PATH=/etc/secrets/supabase-ca.crt
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
FRONTEND_ORIGIN=http://localhost:3000
WORKER_CONCURRENCY=1
# Number of trusted reverse proxy hops; 1 on Render, 0 when running directly.
TRUST_PROXY_HOPS=0
